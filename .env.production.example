# Production/staging settings for compose.prod.yaml (see docs/deployment.md).
#
# Copy to /opt/montelingo/.env on the server, then: chmod 600 .env
# Never commit the real file, and never paste its values into an issue or chat.
# Values containing `$` (the basic-auth hash) must be in single quotes.

# Public hostname. Caddy gets its certificate, and the API's allowed origin and
# reset-link base are https://<this>.
STAGING_DOMAIN=staging.example.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=ops@example.com

# Basic auth in front of staging. Make the hash with:
#   docker run --rm caddy:2.8.4-alpine caddy hash-password
STAGING_BASIC_AUTH_USER=montelingo
STAGING_BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# PostgreSQL. Use a hex password (openssl rand -hex 32): it becomes part of the
# API's database URL.
POSTGRES_DB=montelingo
POSTGRES_USER=montelingo
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Transactional email provider (Postmark, Resend or SES). Hetzner blocks
# outbound 25 and 465, so use port 587 with STARTTLS.
MONTELINGO_SMTP_HOST=smtp.example.com
MONTELINGO_SMTP_PORT=587
MONTELINGO_SMTP_SECURITY=starttls
MONTELINGO_SMTP_USERNAME=
MONTELINGO_SMTP_PASSWORD=
MONTELINGO_SMTP_FROM=no-reply@example.com
