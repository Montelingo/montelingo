# Shared
MONTELINGO_ENV=development

# The session cookie's name. Read by the API (which sets the cookie) and by the
# web (which checks for it in middleware and forwards it), so set it here for
# both or not at all: a web that looks for another name sends every visitor of
# a protected page back to sign-in. Defaults to montelingo_session.
# MONTELINGO_SESSION_COOKIE_NAME=montelingo_session

# PostgreSQL
POSTGRES_DB=montelingo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Compose's fixed internal network. In production, set this to the private
# subnet containing the web proxy that connects to the API.
MONTELINGO_TRUSTED_PROXIES=172.28.0.0/16

# API
MONTELINGO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/montelingo

# Email (Mailpit in local Compose)
MONTELINGO_SMTP_HOST=mailpit
MONTELINGO_SMTP_PORT=1025
MONTELINGO_SMTP_USERNAME=
MONTELINGO_SMTP_PASSWORD=
MONTELINGO_SMTP_SECURITY=starttls
MONTELINGO_SMTP_FROM=no-reply@montelingo.local

# Web
# Where the web server reaches the API over the internal network. Read at
# runtime by server-side rendering and by the same-origin /api/* proxy.
# Defaults to http://localhost:8000 for local `pnpm dev`. The proxy forwards
# the browser's Origin header, so the API's allowed origins must include the
# web's public origin (for example http://localhost:3000).
API_INTERNAL_BASE_URL=http://api:8000

# How many proxies in front of the web append the client's address to
# X-Forwarded-For (the TLS-terminating edge or load balancer). The /api/* proxy
# sends the API the entry that many positions from the right as the client IP.
# 0 (the default, no edge) trusts nothing and sends no client IP. In production
# use 1 for a single load balancer or 2 for CDN -> load balancer, and make the
# web reachable only through them. See docs/frontend-architecture.md §5.3.
TRUSTED_PROXY_HOPS=0
