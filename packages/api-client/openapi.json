{
  "components": {
    "schemas": {
      "Chapter": {
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "position": {
            "description": "Recording order (1-30).",
            "minimum": 1.0,
            "title": "Position",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/Word"
            },
            "title": "Words",
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "position",
          "words"
        ],
        "title": "Chapter",
        "type": "object"
      },
      "CurrentUser": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "title": "CurrentUser",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "default": "invalid_value",
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "default": "Invalid value",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "LiveHealth": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LiveHealth",
        "type": "object"
      },
      "LocationDetail": {
        "properties": {
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/Chapter"
            },
            "title": "Chapters",
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "region_id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Region Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "region_id",
          "chapters"
        ],
        "title": "LocationDetail",
        "type": "object"
      },
      "LocationState": {
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "locked",
              "available",
              "in-progress",
              "completed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state"
        ],
        "title": "LocationState",
        "type": "object"
      },
      "LocationSummary": {
        "properties": {
          "chapter_count": {
            "minimum": 0.0,
            "title": "Chapter Count",
            "type": "integer"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "region_id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Region Id",
            "type": "string"
          },
          "word_count": {
            "minimum": 0.0,
            "title": "Word Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "region_id",
          "chapter_count",
          "word_count"
        ],
        "title": "LocationSummary",
        "type": "object"
      },
      "PageInfo": {
        "properties": {
          "has_more": {
            "default": false,
            "title": "Has More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "next_cursor",
          "has_more"
        ],
        "title": "PageInfo",
        "type": "object"
      },
      "PaginatedResponse_RegionSummary_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RegionSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "page"
        ],
        "title": "PaginatedResponse[RegionSummary]",
        "type": "object"
      },
      "PasswordResetConfirm": {
        "properties": {
          "new_password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password",
            "type": "string"
          },
          "token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "new_password"
        ],
        "title": "PasswordResetConfirm",
        "type": "object"
      },
      "PasswordResetRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "PasswordResetRequest",
        "type": "object"
      },
      "ProgressState": {
        "properties": {
          "locations": {
            "items": {
              "$ref": "#/components/schemas/LocationState"
            },
            "title": "Locations",
            "type": "array"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RegionState"
            },
            "title": "Regions",
            "type": "array"
          }
        },
        "required": [
          "regions",
          "locations"
        ],
        "title": "ProgressState",
        "type": "object"
      },
      "ReadyHealth": {
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadyHealth",
        "type": "object"
      },
      "RegionDetail": {
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "locations": {
            "items": {
              "$ref": "#/components/schemas/LocationSummary"
            },
            "title": "Locations",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "locations"
        ],
        "title": "RegionDetail",
        "type": "object"
      },
      "RegionState": {
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "locked",
              "available",
              "in-progress",
              "completed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state"
        ],
        "title": "RegionState",
        "type": "object"
      },
      "RegionSummary": {
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "location_count": {
            "minimum": 0.0,
            "title": "Location Count",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "location_count"
        ],
        "title": "RegionSummary",
        "type": "object"
      },
      "SignInRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignUpRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignUpRequest",
        "type": "object"
      },
      "Word": {
        "properties": {
          "audio_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Url"
          },
          "id": {
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "number": {
            "description": "Recording number (1-300), also the audio file name.",
            "minimum": 1.0,
            "title": "Number",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "text",
          "note",
          "image_url",
          "audio_url"
        ],
        "title": "Word",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Montelingo API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/me": {
      "get": {
        "operationId": "auth_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password-reset": {
      "post": {
        "operationId": "auth_password_reset_request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Request Password Reset",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "operationId": "auth_password_reset_confirm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Confirm Password Reset",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "operationId": "auth_sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Sign In",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "operationId": "auth_sign_out",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Sign Out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sign-up": {
      "post": {
        "operationId": "auth_sign_up",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Sign Up",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "health_live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealth"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
