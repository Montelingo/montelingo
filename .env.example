# Shared
MONTELINGO_ENV=development

# PostgreSQL
POSTGRES_DB=montelingo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API
MONTELINGO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/montelingo

# Email (Mailpit in local Compose)
MONTELINGO_SMTP_HOST=mailpit
MONTELINGO_SMTP_PORT=1025
MONTELINGO_SMTP_USERNAME=
MONTELINGO_SMTP_PASSWORD=
MONTELINGO_SMTP_SECURITY=starttls
MONTELINGO_SMTP_FROM=no-reply@montelingo.local

# Web
API_INTERNAL_BASE_URL=http://api:8000
