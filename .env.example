# Shared
MONTELINGO_ENV=development

# PostgreSQL
POSTGRES_DB=montelingo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API
MONTELINGO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/montelingo

# Email (Mailpit in local Compose)
MONTELINGO_SMTP_HOST=mailpit
MONTELINGO_SMTP_PORT=1025
MONTELINGO_SMTP_USERNAME=
MONTELINGO_SMTP_PASSWORD=
MONTELINGO_SMTP_SECURITY=starttls
MONTELINGO_SMTP_FROM=no-reply@montelingo.local

# Web
# Where the web server reaches the API over the internal network. Read at
# runtime by server-side rendering and by the same-origin /api/* proxy.
# Defaults to http://localhost:8000 for local `pnpm dev`. The proxy forwards
# the browser's Origin header, so the API's allowed origins must include the
# web's public origin (for example http://localhost:3000).
API_INTERNAL_BASE_URL=http://api:8000
